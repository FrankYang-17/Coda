# Coding agent: responses, chat, anthropic or gemini.
AGENT_PROTOCOL=responses
MODEL=your-coding-model
BASE_URL=https://api.openai.com/v1
API_KEY=
AGENT_MAX_OUTPUT_TOKENS=16384

# Image generation: OpenAI-compatible Images API, including image edits.
IMAGE_MODEL=your-image-model
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=

# Video generation: the media-upload and async-video gateway described in docs/providers.md.
VIDEO_MODEL=your-video-model
VIDEO_MODEL_BASE_URL=https://your-video-gateway.example
VIDEO_MODEL_API_KEY=
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=16:9

# Paths are relative to the directory from which you launch the CLI.
BLENDER_EXECUTABLE=external/blender/blender
BLENDER_VERSION=4.5
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
BWRAP_EXECUTABLE=/usr/bin/bwrap
CUDA_VISIBLE_DEVICES=0
